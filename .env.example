# Copy to .env and fill in real values. .env is gitignored; never commit credentials.

# Required. PostgreSQL connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Required. AES-256-GCM key: 32 random bytes encoded base64url (43 characters).
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Leave empty here on purpose. Keep the real value out of the database and out of
# version control: it is the only thing protecting secret contents, and it cannot be recovered.
SECRET_ENCRYPTION_KEY=

# Optional. Comma-separated addresses of the proxies you control, allowed to supply
# X-Forwarded-For. Empty means trust nobody: all clients then share one rate limit bucket.
# Applied by server.mjs, which strips every x-forwarded-* header from untrusted peers
# so a client cannot spoof its address and evade rate limiting. Note that "npm run dev"
# does not go through server.mjs and therefore shares one bucket.
TRUSTED_PROXIES=

# Optional. Hostnames this deployment answers to, comma separated. Leading "*."
# wildcards are allowed. Read at BUILD time by astro.config.mjs; rebuild after
# changing it. With an empty list Astro rewrites every request URL to
# http://localhost, which breaks generated links and rejects legitimate browser
# POSTs. The default in astro.config.mjs is localhost,127.0.0.1 for development.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Extra origins accepted for same-origin POSTs.
# Empty means only the deployment's own origin.
ALLOWED_ORIGINS=

# Optional. Rate limits per client IP, fixed window, counters kept in PostgreSQL.
RATE_LIMIT_CREATE_MAX=20
RATE_LIMIT_CREATE_WINDOW_SECONDS=3600
RATE_LIMIT_REVEAL_MAX=30
RATE_LIMIT_REVEAL_WINDOW_SECONDS=300

# Optional. Secure attribute on the locale cookie.
# Defaults to true when NODE_ENV=production, false otherwise.
COOKIE_SECURE=true

# Optional. Read only by "npm run cleanup": age after which idle rate limit
# counters are deleted. Must be a non-negative integer.
CLEANUP_KEEP_COUNTER_SECONDS=3600
