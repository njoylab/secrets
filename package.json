{
  "name": "secrets",
  "version": "0.1.0",
  "description": "One-time secret sharing with browser-side encryption, control links, and cancellation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "build": "node ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file-if-exists=.env ./server.mjs",
    "start": "node --env-file-if-exists=.env ./scripts/start.mjs",
    "astro": "astro",
    "typecheck": "astro check",
    "migrate": "node --env-file-if-exists=.env ./scripts/migrate.mjs",
    "cleanup": "node --env-file-if-exists=.env ./scripts/cleanup.mjs",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs",
    "test:browser": "playwright test",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
