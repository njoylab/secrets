{
  "name": "secrets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/astro.js dev",
    "build": "node ./node_modules/astro/astro.js build",
    "preview": "node --env-file-if-exists=.env ./server.mjs",
    "start": "node --env-file-if-exists=.env ./server.mjs",
    "astro": "astro",
    "typecheck": "astro check",
    "migrate": "node --env-file-if-exists=.env ./scripts/migrate.mjs",
    "cleanup": "node --env-file-if-exists=.env ./scripts/cleanup.mjs",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env --env-file-if-exists=.env.test ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.0",
    "astro": "^5.14.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
