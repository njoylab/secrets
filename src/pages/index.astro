---
import CreateForm from '../components/CreateForm.astro';
import ResultPanel from '../components/ResultPanel.astro';
import Layout from '../layouts/Layout.astro';
import { getDictionary } from '../lib/i18n.ts';

export const prerender = false;

const t = getDictionary(Astro.locals.locale);
---

<Layout title={t.create.title}>
  <section class="hero compact">
    <div class="container">
      <h1><span class="mono">secrets</span> {t.create.hero}</h1>
      <p>
        {t.meta.description}<br />
        {t.footer.limits}
      </p>
    </div>
  </section>
  <section id="create" class="section no-border">
    <div class="container">
      <div class="tool-wrap">
        <div class="section-header">
          <h2>{t.create.section}</h2>
          <p>{t.create.noteSingleRead}</p>
        </div>
        <CreateForm />
        <ResultPanel />
      </div>
    </div>
  </section>
  <section id="contact" class="section bg-light">
    <div class="container">
      <div class="section-header">
        <h2>{t.contact.title}</h2>
        <p>{t.contact.lead}</p>
      </div>
      <div class="contact-info">
        <div class="contact-item">
          <h3>{t.contact.email}</h3>
          support at echovalue dot dev
        </div>
        <div class="contact-item">
          <h3>{t.contact.social}</h3>
          <div class="social-links">
            <a href="https://twitter.com/emln_" aria-label={t.contact.twitter} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 5.8c-.7.3-1.5.6-2.2.7a3.9 3.9 0 0 0 1.7-2.2 7.8 7.8 0 0 1-2.5 1 3.9 3.9 0 0 0-6.7 3.6A11.1 11.1 0 0 1 3.1 4.9a3.9 3.9 0 0 0 1.2 5.2 3.8 3.8 0 0 1-1.8-.5v.1a3.9 3.9 0 0 0 3.1 3.8 3.9 3.9 0 0 1-1.8.1 3.9 3.9 0 0 0 3.6 2.7A7.8 7.8 0 0 1 2 18.4a11 11 0 0 0 6 1.8c7.2 0 11.1-6 11.1-11.1v-.5A7.8 7.8 0 0 0 22 5.8z"></path></svg>
            </a>
            <a href="https://www.linkedin.com/in/emlns/" aria-label={t.contact.linkedin} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.7 3.3A2.2 2.2 0 1 1 4.7 7.7 2.2 2.2 0 0 1 4.7 3.3zM3 9h3.4v12H3zM9.3 9h3.3v1.6h.1c.5-.9 1.6-1.8 3.3-1.8 3.5 0 4.2 2.3 4.2 5.3V21H16.8v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9.3z"></path></svg>
            </a>
            <a href="https://github.com/njoylab" aria-label={t.contact.github} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7 3.6 3.6 0 0 1 .1-2.6s.8-.3 2.8 1a9.6 9.6 0 0 1 5 0c2-1.3 2.8-1 2.8-1a3.6 3.6 0 0 1 .1 2.6 3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import {
    controlUrl,
    deriveSecretKeys,
    encodeShareFragment,
    encryptPayload,
    generateContentKey,
    generatePasswordSalt,
    hashAuthKey,
    normalizedPasswordLength,
    shareUrl,
  } from '../lib/content-crypto.ts';
  import { encodeQr, type QrSymbol } from '../lib/qr.ts';

  interface CreateApiResponse {
    ok?: boolean;
    token?: string;
    controlToken?: string;
    expiresAt?: string;
    message?: string;
  }

  /** Deprecated selection based copy, reached only when the Clipboard API is unusable. */
  interface LegacyClipboard {
    execCommand(commandId: string): boolean;
  }

  /** A copy row: the field to copy from and the button that copies it. */
  interface BoundCopyRow {
    readonly field: HTMLInputElement;
    readonly button: HTMLButtonElement;
    readonly status: HTMLElement;
  }

  const COPY_RESET_DELAY = 1500;

  function byId<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  /** Clipboard API first, selection based copy as the fallback for insecure contexts. */
  async function copyToClipboard(text: string): Promise<boolean> {
    if (!text) return false;

    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Permission denied: fall through to the manual selection below.
      }
    }

    const previous = document.activeElement;
    const helper = document.createElement('textarea');
    helper.value = text;
    helper.setAttribute('readonly', '');
    helper.style.position = 'fixed';
    helper.style.top = '-1000px';
    helper.style.opacity = '0';
    document.body.appendChild(helper);
    try {
      helper.select();
      helper.setSelectionRange(0, text.length);
      return (document as unknown as LegacyClipboard).execCommand('copy');
    } catch {
      return false;
    } finally {
      helper.remove();
      if (previous instanceof HTMLElement) previous.focus();
    }
  }

  /**
   * Draw the share link as a QR code on the canvas.
   *
   * The link is composed here from the page origin and the token in the
   * response, exactly as the text field above is, so no third party origin and
   * no server round trip is involved. The canvas is sized in whole modules so
   * the code stays square and crisp: the drawing area is the module grid plus a
   * four module quiet zone, scaled by an integer.
   *
   * The accessible name comes from the visible label the markup already points
   * at with `aria-labelledby`, so it is not set again here: two name sources
   * would only invite them to drift apart.
   */
  function drawQrCode(canvas: HTMLCanvasElement, link: string): boolean {
    let symbol: QrSymbol;
    try {
      symbol = encodeQr(link);
    } catch {
      // A link far longer than any real one cannot be encoded: leave the canvas
      // hidden rather than showing a broken code.
      return false;
    }

    const quietZone = 4;
    const modules = symbol.size + quietZone * 2;
    // Whole-number pixels per module, so the grid stays crisp at any size.
    const scale = Math.max(1, Math.floor(232 / modules));
    const extent = modules * scale;

    canvas.width = extent;
    canvas.height = extent;

    const context = canvas.getContext('2d');
    if (!context) return false;
    context.fillStyle = '#ffffff';
    context.fillRect(0, 0, extent, extent);
    context.fillStyle = '#000000';
    for (let row = 0; row < symbol.size; row += 1) {
      for (let column = 0; column < symbol.size; column += 1) {
        if (!symbol.isDark(row, column)) continue;
        context.fillRect((column + quietZone) * scale, (row + quietZone) * scale, scale, scale);
      }
    }
    return true;
  }

  function formatInstant(value: string, locale: string): string {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;
    try {
      return new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' }).format(date);
    } catch {
      return value;
    }
  }

  function initCreateFlow(): void {
    if (!window.isSecureContext || !window.crypto?.subtle) return;
    const form = byId<HTMLFormElement>('create-form');
    const panel = byId<HTMLElement>('result-panel');
    const status = byId<HTMLElement>('create-status');
    const submit = byId<HTMLButtonElement>('create-submit');
    const secret = byId<HTMLTextAreaElement>('secret');
    const expiry = byId<HTMLSelectElement>('expiry');
    const password = byId<HTMLInputElement>('create-password');
    const resultStatus = byId<HTMLElement>('result-status');
    const expiryValue = byId<HTMLElement>('result-expiry-value');
    const expiryPreset = byId<HTMLElement>('result-expiry-preset');
    const passwordField = byId<HTMLElement>('result-password-field');
    const passwordEcho = byId<HTMLInputElement>('result-password');
    const another = byId<HTMLButtonElement>('result-another');
    const resultLink = byId<HTMLInputElement>('result-link');
    const resultCopy = byId<HTMLButtonElement>('result-copy');
    const controlLink = byId<HTMLInputElement>('result-control-link');
    const controlCopy = byId<HTMLButtonElement>('result-control-copy');
    const passwordCopy = byId<HTMLButtonElement>('result-password-copy');
    const qrField = byId<HTMLElement>('result-qr-field');
    const qrCanvas = byId<HTMLCanvasElement>('result-qr');

    if (
      !form ||
      !panel ||
      !status ||
      !submit ||
      !secret ||
      !expiry ||
      !password ||
      !resultStatus ||
      !expiryValue ||
      !expiryPreset ||
      !passwordField ||
      !passwordEcho ||
      !another ||
      !resultLink ||
      !resultCopy ||
      !controlLink ||
      !controlCopy ||
      !passwordCopy ||
      !qrField ||
      !qrCanvas
    ) {
      return;
    }

    // Every half of every copy row is on the page, so the rows are whole.
    const shareRow: BoundCopyRow = { field: resultLink, button: resultCopy, status: resultStatus };
    const controlRow: BoundCopyRow = { field: controlLink, button: controlCopy, status: resultStatus };
    const rows: readonly BoundCopyRow[] = [
      shareRow,
      controlRow,
      { field: passwordEcho, button: passwordCopy, status: resultStatus },
    ];

    // Captured once so the closures below keep the narrowed element types.
    const fields = [secret, expiry, password];

    const formData = form.dataset;
    const serverError = formData.errorServer ?? '';
    const secretMax = Number(formData.secretMax ?? 0);
    const passwordMax = Number(formData.passwordMax ?? 0);
    const presets = (formData.expiryPresets ?? '').split(',').filter((entry) => entry.length > 0);
    const expiryLabels: Readonly<Record<string, string>> = JSON.parse(
      formData.expiryLabels ?? '{}',
    ) as Record<string, string>;
    const encoder = new TextEncoder();

    const submitIdle = submit.dataset.labelIdle ?? submit.textContent ?? '';
    const submitBusy = submit.dataset.labelBusy ?? submitIdle;

    // Original hint associations, so error wiring stays reversible.
    const describedBy = new Map<string, string>();
    for (const field of fields) {
      describedBy.set(field.id, field.getAttribute('aria-describedby') ?? '');
    }

    const copyTimers = new Map<HTMLButtonElement, number>();

    /**
     * The label lives in its own span: assigning textContent on the button
     * itself would throw the icons away on the first copy.
     */
    const setButtonLabel = (button: HTMLButtonElement, text: string): void => {
      const label = button.querySelector<HTMLElement>('.btn-label');
      if (label) {
        label.textContent = text;
        return;
      }
      button.textContent = text;
    };

    const clearErrors = (): void => {
      status.textContent = '';
      status.classList.remove('is-error');
      for (const field of fields) {
        field.removeAttribute('aria-invalid');
        field.setAttribute('aria-describedby', describedBy.get(field.id) ?? '');
      }
    };

    const showError = (field: HTMLElement | null, message: string): void => {
      clearErrors();
      status.textContent = message;
      // Failures are never painted in the confirmation hue.
      status.classList.add('is-error');
      if (!field) return;
      const base = describedBy.get(field.id) ?? '';
      field.setAttribute('aria-invalid', 'true');
      field.setAttribute('aria-describedby', base ? `${base} ${status.id}` : status.id);
    };

    const validate = (): { field: HTMLElement; message: string } | null => {
      if (secret.value.length === 0) {
        return { field: secret, message: formData.errorPayloadRequired ?? '' };
      }
      if (secretMax > 0 && encoder.encode(secret.value).length > secretMax) {
        return { field: secret, message: formData.errorPayloadTooLong ?? '' };
      }
      if (!presets.includes(expiry.value)) {
        return { field: expiry, message: formData.errorInvalidExpiry ?? '' };
      }
      // Measured after NFKC, exactly as the key derivation measures it.
      if (passwordMax > 0 && normalizedPasswordLength(password.value) > passwordMax) {
        return { field: password, message: formData.errorPasswordTooLong ?? '' };
      }
      return null;
    };

    const resetCopyFeedback = (): void => {
      for (const row of rows) {
        const timer = copyTimers.get(row.button);
        if (timer !== undefined) window.clearTimeout(timer);
        copyTimers.delete(row.button);
        setButtonLabel(row.button, row.button.dataset.labelIdle ?? '');
        row.button.dataset.copied = 'false';
      }
      resultStatus.textContent = '';
      resultStatus.classList.remove('is-error');
    };

    const showResult = (payload: CreateApiResponse, preset: string, keyFragment: string): boolean => {
      // Both links are attached to this page's origin. Absolute URLs from the
      // response are never used, so neither the content key nor a host this
      // process may have misresolved can be sent to a third party.
      const share = typeof payload.token === 'string' ? shareUrl(window.location.origin, payload.token) : null;
      const control =
        typeof payload.controlToken === 'string'
          ? controlUrl(window.location.origin, payload.controlToken)
          : null;
      if (!share || !control) return false;
      const shareLink = `${share}#${keyFragment}`;
      shareRow.field.value = shareLink;
      controlRow.field.value = control;
      expiryPreset.textContent = expiryLabels[preset] ?? '';
      expiryValue.textContent = formatInstant(payload.expiresAt ?? '', expiryValue.dataset.locale ?? 'en');
      // The password leaves the form only when it was actually set, and only into
      // this page: it never returns in a response body and never enters a link.
      passwordEcho.value = password.value;
      passwordField.hidden = password.value.length === 0;
      // The code carries the key, so it is drawn only once the link exists and
      // is torn down with the rest of the result.
      const drawn = drawQrCode(qrCanvas, shareLink);
      qrCanvas.hidden = !drawn;
      qrField.hidden = !drawn;
      resultStatus.textContent = '';
      resultStatus.classList.remove('is-error');
      // The plaintext has left the page: drop it from the DOM as well.
      secret.value = '';
      form.hidden = true;
      panel.hidden = false;
      panel.focus();
      return true;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const invalid = validate();
      if (invalid) {
        showError(invalid.field, invalid.message);
        invalid.field.focus();
        return;
      }

      const preset = expiry.value;
      const suppliedPassword = password.value;
      let keyFragment = '';

      submit.setAttribute('aria-busy', 'true');
      submit.disabled = true;
      setButtonLabel(submit, submitBusy);

      try {
        // Sealed here, before anything leaves the browser. The fragment key is
        // generated per secret; a password is mixed into the derived keys and
        // is not in the body. Only the hash of the auth key is sent.
        const key = generateContentKey();
        const hasPassword = suppliedPassword.length > 0;
        const salt = hasPassword ? generatePasswordSalt() : null;
        const { contentKey, authKey } = await deriveSecretKeys(key, hasPassword ? suppliedPassword : null, salt);
        keyFragment = encodeShareFragment(key, salt);
        const body = {
          payload: await encryptPayload(secret.value, contentKey),
          expiresIn: preset,
          authHash: await hashAuthKey(authKey),
          passwordProtected: hasPassword,
        };

        const response = await fetch('/api/secrets', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const payloadBody = (await response.json()) as CreateApiResponse;

        if (
          !response.ok ||
          payloadBody.ok !== true ||
          typeof payloadBody.token !== 'string' ||
          typeof payloadBody.controlToken !== 'string'
        ) {
          showError(null, typeof payloadBody.message === 'string' ? payloadBody.message : serverError);
          return;
        }
        if (!showResult(payloadBody, preset, keyFragment)) {
          showError(null, serverError);
        }
      } catch {
        showError(null, serverError);
      } finally {
        submit.removeAttribute('aria-busy');
        submit.disabled = false;
        setButtonLabel(submit, submitIdle);
      }
    });

    for (const { field, button } of rows) {
      button.addEventListener('click', async () => {
        const copied = await copyToClipboard(field.value);
        const previous = copyTimers.get(button);
        if (previous !== undefined) window.clearTimeout(previous);

        const idle = button.dataset.labelIdle ?? '';
        const done = button.dataset.labelDone ?? '';
        const failed = button.dataset.labelFailed ?? '';
        button.dataset.copied = copied ? 'true' : 'false';
        setButtonLabel(button, copied ? done : idle);
        resultStatus.textContent = copied ? done : failed;
        copyTimers.set(
          button,
          window.setTimeout(() => {
            setButtonLabel(button, idle);
            button.dataset.copied = 'false';
            if (resultStatus.textContent === done || resultStatus.textContent === failed) {
              resultStatus.textContent = '';
            }
          }, COPY_RESET_DELAY),
        );
      });
    }

    another.addEventListener('click', () => {
      resetCopyFeedback();
      panel.hidden = true;
      form.hidden = false;
      form.reset();
      // The code holds the content key in pixels, so it is cleared before the
      // next secret is on screen rather than left behind a hidden panel.
      qrCanvas.hidden = true;
      qrField.hidden = true;
      qrCanvas.width = 0;
      qrCanvas.height = 0;
      // The echo sits outside the form, so form.reset() does not reach it: the
      // password must not survive in the DOM once the next secret is on screen.
      passwordEcho.value = '';
      passwordField.hidden = true;
      clearErrors();
      secret.focus();
    });

    // Native submission must never serialize plaintext, even before this handler exists.
    submit.disabled = false;
    const runtimeNote = byId<HTMLElement>('create-runtime-note');
    if (runtimeNote) runtimeNote.hidden = true;
  }

  initCreateFlow();
</script>
