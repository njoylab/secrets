---
import Notice from '../../components/Notice.astro';
import Panel from '../../components/Panel.astro';
import PasswordField from '../../components/PasswordField.astro';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { getDictionary } from '../../lib/i18n.ts';
import { peekSecretPresence } from '../../lib/secrets.ts';

export const prerender = false;

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const token = Astro.params.token ?? '';
// Rendering only checks presence: it never decrypts and never deletes. The
// content key lives in the fragment, which the browser never sends here.
const presence = await peekSecretPresence(token);
---

<Layout title={t.open.title}>
  <h1 class="page-title">{t.open.title}</h1>

  {
    presence === null ? (
      <Panel>
        <p class="notice-message">{t.open.unavailable}</p>
      </Panel>
    ) : (
      <>
        <Panel id="open-panel">
          <form
            id="open-form"
            class="form"
            novalidate
            data-token={token}
            data-password-mode={presence.password}
            data-error-server={t.errors.serverError}
            data-error-bad-password={t.errors.badPassword}
            data-error-missing-key={t.open.missingKey}
            data-error-key-failed={t.open.keyFailed}
          >
            {presence.password !== 'none' && (
              <PasswordField
                id="open-password"
                label={t.open.passwordLabel}
                showLabel={t.open.passwordShow}
                hideLabel={t.open.passwordHide}
                autocomplete="current-password"
                required
              />
            )}
            <p class="status" id="open-status" role="status" aria-live="polite"></p>
            <button
              type="submit"
              class="btn btn-primary btn-block"
              id="open-submit"
              data-label-idle={t.open.reveal}
              data-label-busy={t.open.revealing}
            >
              <Icon name="key" />
              <span class="btn-label">{t.open.reveal}</span>
            </button>
            <p class="note">{t.open.noteSingleRead}</p>
          </form>
        </Panel>

        <Panel id="secret-panel" heading={t.secret.panelTitle} headingId="secret-title" hidden>
          <pre class="secret" id="secret-text" tabindex="0" translate="no"></pre>
          <button
            type="button"
            class="btn btn-ghost btn-copy align-start"
            id="secret-copy"
            data-label-idle={t.secret.copy}
            data-label-done={t.secret.copied}
            data-label-failed={t.secret.copyFailed}
          >
            <Icon name="copy" class="icon icon-copy" />
            <Icon name="check" class="icon icon-done" />
            <span class="btn-label">{t.secret.copy}</span>
          </button>
          <p class="status" id="secret-status" role="status" aria-live="polite"></p>
          <p class="panel-title">{t.secret.consumed}</p>
          <p class="note">{t.secret.consumedHint}</p>
        </Panel>

        <Notice
          id="secret-consumed"
          headingId="secret-consumed-title"
          hintId="secret-consumed-hint"
          heading={t.secret.consumed}
          hint={t.secret.consumedHint}
          live
          hidden
        />
      </>
    )
  }
</Layout>

<script>
  import {
    PASSWORD_VERIFIER_TEXT,
    decodeShareFragment,
    decryptPayload,
    derivePasswordKey,
    type ContentBytes,
  } from '../../lib/content-crypto.ts';

  interface RevealApiResponse {
    ok?: boolean;
    payload?: string;
    error?: string;
    message?: string;
  }

  /** Deprecated selection based copy, reached only when the Clipboard API is unusable. */
  interface LegacyClipboard {
    execCommand(commandId: string): boolean;
  }

  const COPY_RESET_DELAY = 1500;

  function byId<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  /** Clipboard API first, selection based copy as the fallback for insecure contexts. */
  async function copyToClipboard(text: string): Promise<boolean> {
    if (!text) return false;

    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Permission denied: fall through to the manual selection below.
      }
    }

    const previous = document.activeElement;
    const helper = document.createElement('textarea');
    helper.value = text;
    helper.setAttribute('readonly', '');
    helper.style.position = 'fixed';
    helper.style.top = '-1000px';
    helper.style.opacity = '0';
    document.body.appendChild(helper);
    try {
      helper.select();
      helper.setSelectionRange(0, text.length);
      return (document as unknown as LegacyClipboard).execCommand('copy');
    } catch {
      return false;
    } finally {
      helper.remove();
      if (previous instanceof HTMLElement) previous.focus();
    }
  }

  /**
   * Read the fragment once, then drop it from the address bar.
   *
   * The current history entry is replaced, so a later copy of the URL, a
   * synced history and a shared screen do not carry the content key. The key
   * stays in this closure until the page is closed.
   */
  function takeFragment(): ReturnType<typeof decodeShareFragment> {
    const fragment = decodeShareFragment(window.location.hash.replace(/^#/, ''));
    if (window.location.hash.length > 0) {
      const bare = `${window.location.pathname}${window.location.search}`;
      window.history.replaceState(null, '', bare);
    }
    return fragment;
  }

  const openedFragment = takeFragment();

  function initRevealFlow(): void {
    const form = byId<HTMLFormElement>('open-form');
    const status = byId<HTMLElement>('open-status');
    const submit = byId<HTMLButtonElement>('open-submit');
    const password = byId<HTMLInputElement>('open-password');
    const secretPanel = byId<HTMLElement>('secret-panel');
    const secretText = byId<HTMLElement>('secret-text');
    const copyButton = byId<HTMLButtonElement>('secret-copy');
    const copyStatus = byId<HTMLElement>('secret-status');
    const consumed = byId<HTMLElement>('secret-consumed');
    const consumedHint = byId<HTMLElement>('secret-consumed-hint');

    if (!form || !status || !submit || !secretPanel || !secretText || !copyButton || !copyStatus) {
      return;
    }

    // The token travels as a data attribute, never as an interpolated script string.
    const token = form.dataset.token ?? '';
    const passwordMode = form.dataset.passwordMode ?? 'none';
    const serverError = form.dataset.errorServer ?? '';
    const badPassword = form.dataset.errorBadPassword ?? '';
    const missingKey = form.dataset.errorMissingKey ?? '';
    const keyFailed = form.dataset.errorKeyFailed ?? '';
    const fragmentKey = openedFragment?.key ?? null;
    const salt = openedFragment?.salt ?? null;
    const revealIdle = submit.dataset.labelIdle ?? submit.textContent ?? '';
    const revealBusy = submit.dataset.labelBusy ?? revealIdle;
    const copyIdle = copyButton.dataset.labelIdle ?? '';
    const copyDone = copyButton.dataset.labelDone ?? '';
    const copyFailed = copyButton.dataset.labelFailed ?? '';

    // A revealed secret is consumed server side: no second read is ever attempted.
    let revealed = false;
    let copyTimer = 0;

    /**
     * Every message this page can produce is a failure: a dead link, a wrong
     * password, a spent row. They are therefore written through one helper, so
     * no branch can quietly land in the confirmation hue.
     */
    const fail = (message: string): void => {
      status.textContent = message;
      status.classList.add('is-error');
    };

    /** The label lives in its own span: the icons must survive label swaps. */
    const setButtonLabel = (button: HTMLButtonElement, text: string): void => {
      const label = button.querySelector<HTMLElement>('.btn-label');
      if (label) {
        label.textContent = text;
        return;
      }
      button.textContent = text;
    };

    /**
     * The single dead end. `message` replaces the hint only when the reason is
     * worth naming: a tampered key is a different failure from a spent link, even
     * though both end with the payload already gone.
     */
    const showConsumed = (message?: string): void => {
      form.hidden = true;
      if (password) password.value = '';
      if (message && consumedHint) consumedHint.textContent = message;
      if (!consumed) return;
      consumed.hidden = false;
      // The panel carries a live region of its own, so the reason is announced
      // from the visible copy rather than from the form that just went away.
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (revealed) return;

      // Without a usable key the POST cannot produce anything readable, and it
      // would consume the secret to prove it. Refuse before spending it.
      if (!fragmentKey) {
        fail(missingKey);
        return;
      }
      if (passwordMode === 'client' && !salt) {
        fail(missingKey);
        return;
      }
      if (passwordMode !== 'client' && salt) {
        fail(keyFailed);
        return;
      }

      status.textContent = '';
      status.classList.remove('is-error');
      submit.setAttribute('aria-busy', 'true');
      submit.disabled = true;
      setButtonLabel(submit, revealBusy);

      let openingKey: ContentBytes = fragmentKey;

      try {
        if (passwordMode === 'client') {
          const supplied = password?.value ?? '';
          if (supplied.length === 0 || !salt) {
            fail(badPassword);
            if (password) password.focus();
            return;
          }
          const check = await fetch('/api/secrets/verifier', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token }),
          });
          const checkBody = (await check.json()) as RevealApiResponse & { verifier?: string };
          if (!check.ok || checkBody.ok !== true || typeof checkBody.verifier !== 'string') {
            fail(typeof checkBody.message === 'string' ? checkBody.message : serverError);
            return;
          }
          try {
            openingKey = await derivePasswordKey(fragmentKey, supplied, salt);
            const opened = await decryptPayload(checkBody.verifier, openingKey);
            if (opened !== PASSWORD_VERIFIER_TEXT) throw new Error('Verifier text did not match');
          } catch {
            fail(badPassword);
            if (password) {
              password.focus();
              password.select();
            }
            return;
          }
        }

        const body: { token: string; password?: string } = { token };
        // Legacy rows still gate reveal on the server. New rows never send it.
        if (passwordMode === 'server' && password && password.value.length > 0) {
          body.password = password.value;
        }

        const response = await fetch('/api/secrets/reveal', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const payload = (await response.json()) as RevealApiResponse;

        if (response.ok && payload.ok === true && typeof payload.payload === 'string') {
          revealed = true;
          // The row is already gone at this point: a failed tag means the key was
          // altered in transit, and there is no second read to fall back on.
          let plaintext: string;
          try {
            plaintext = await decryptPayload(payload.payload, openingKey);
          } catch {
            showConsumed(keyFailed);
            return;
          }
          // textContent keeps the secret inert: markup is never interpreted.
          secretText.textContent = plaintext;
          form.hidden = true;
          if (password) password.value = '';
          secretPanel.hidden = false;
          secretPanel.focus();
          return;
        }

        // Missing, expired and already consumed share one single server answer.
        if (payload.error === 'unavailable') {
          revealed = true;
          showConsumed();
          return;
        }

        fail(typeof payload.message === 'string' ? payload.message : serverError);
        if (payload.error === 'badPassword' && password) {
          password.focus();
          password.select();
        }
      } catch {
        fail(serverError);
      } finally {
        submit.removeAttribute('aria-busy');
        submit.disabled = false;
        setButtonLabel(submit, revealIdle);
      }
    });

    copyButton.addEventListener('click', async () => {
      const copied = await copyToClipboard(secretText.textContent ?? '');
      window.clearTimeout(copyTimer);
      copyButton.dataset.copied = copied ? 'true' : 'false';
      setButtonLabel(copyButton, copied ? copyDone : copyIdle);
      copyStatus.textContent = copied ? copyDone : copyFailed;
      copyTimer = window.setTimeout(() => {
        copyButton.dataset.copied = 'false';
        setButtonLabel(copyButton, copyIdle);
        copyStatus.textContent = '';
      }, COPY_RESET_DELAY);
    });
  }

  initRevealFlow();
</script>
