---
import Panel from '../components/Panel.astro';
import Layout from '../layouts/Layout.astro';
import { getDictionary } from '../lib/i18n.ts';

// Rendered per request so the middleware's locale applies and Astro attaches
// its page CSP with the hashes of the inlined styles.
export const prerender = false;

const t = getDictionary(Astro.locals.locale);
Astro.response.status = 404;
---

<Layout title={t.notFound.title}>
  <section class="section pt-nav">
    <div class="container">
      <div class="tool-wrap">
        <h1>{t.notFound.title}</h1>
        <Panel>
          <p class="notice-message">{t.notFound.message}</p>
          <a class="btn btn-primary align-start" href="/">{t.notFound.home}</a>
        </Panel>
      </div>
    </div>
  </section>
</Layout>
