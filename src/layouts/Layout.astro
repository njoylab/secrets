---
import '../styles/global.css';
import { getDictionary } from '../lib/i18n.ts';
import { getConfig } from '../lib/env.ts';
import { requestOriginFrom } from '../lib/http.ts';
import { robotsForPath } from '../lib/seo.ts';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  title: string;
  /** Overridden by the legal pages, whose summary describes those documents. */
  description?: string;
}

const { title, description } = Astro.props;
const locale = Astro.locals.locale;
const t = getDictionary(locale);
const sourceUrl = getConfig().sourceUrl;
// Language links return to the current path, query string included.
const next = `${Astro.url.pathname}${Astro.url.search}`;

const pageTitle = `${title} · ${t.meta.title}`;
const pageDescription = description ?? t.meta.description;
// Only the public pages may be indexed; token pages and unknown paths stay out.
const robots = robotsForPath(Astro.url.pathname);
// The origin advertised in canonical and Open Graph links, as served.
const origin = requestOriginFrom(Astro.request);
const canonical = origin === 'null' ? null : `${origin}${Astro.url.pathname}`;
const ogLocale = locale === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlternate = locale === 'it' ? 'en_US' : 'it_IT';
// Structured data describes the application itself, so the landing page carries it.
const structuredData =
  Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: t.meta.title,
        applicationCategory: 'SecurityApplication',
        operatingSystem: 'Any',
        browserRequirements: 'Requires a modern browser with JavaScript and Web Crypto',
        description: pageDescription,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      }
    : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0b0d" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">{t.nav.home}</a>
        <LanguageSwitcher locale={locale} next={next} />
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <p class="site-footer-limits">{t.footer.limits}</p>
        <nav class="site-footer-nav" aria-label={t.footer.linksLabel}>
          <a href="/how">{t.footer.how}</a>
          <a href="/privacy">{t.footer.privacy}</a>
          <a href="/terms">{t.footer.terms}</a>
          {sourceUrl && (
            <a href={sourceUrl} title={t.footer.sourceLabel} rel="noopener noreferrer">{t.footer.source}</a>
          )}
        </nav>
      </footer>
    </div>
  </body>
</html>
