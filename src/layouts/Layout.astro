---
import '../styles/dev-theme.css';
import { getDictionary } from '../lib/i18n.ts';
import { getConfig } from '../lib/env.ts';
import { requestOriginFrom } from '../lib/http.ts';
import { robotsForPath } from '../lib/seo.ts';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  title: string;
  /** Overridden by the legal pages, whose summary describes those documents. */
  description?: string;
}

const { title, description } = Astro.props;
const locale = Astro.locals.locale;
const t = getDictionary(locale);
const sourceUrl = getConfig().sourceUrl;
const next = `${Astro.url.pathname}${Astro.url.search}`;

const pageTitle = `${title} · ${t.meta.title}`;
const pageDescription = description ?? t.meta.description;
const robots = robotsForPath(Astro.url.pathname);
const origin = requestOriginFrom(Astro.request);
const canonical = origin === 'null' ? null : `${origin}${Astro.url.pathname}`;
const ogLocale = locale === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlternate = locale === 'it' ? 'en_US' : 'it_IT';
const ogImage = origin === 'null' ? null : `${origin}/images/echovalue-og.png`;
const here = Astro.url.pathname;
const structuredData =
  here === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: t.meta.title,
        applicationCategory: 'SecurityApplication',
        operatingSystem: 'Any',
        browserRequirements: 'Requires a modern browser with JavaScript and Web Crypto',
        description: pageDescription,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      }
    : null;
---

<!DOCTYPE HTML>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Emiliano Saurin" />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0a0a" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
        />
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skipToContent}</a>
    <nav class="navbar">
      <div class="container">
        <a href="/" class="navbar-brand">echoValue Secrets</a>
        <button class="theme-toggle" type="button" aria-label={t.themeToggle}>
          <svg class="fa-solid fa-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
          </svg>
          <svg class="fa-solid fa-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
        <button class="navbar-toggle" type="button" aria-label={t.nav.menu}>
          <span></span>
          <span></span>
          <span></span>
        </button>
        <ul class="navbar-nav">
          <li><a href="/" aria-current={here === '/' ? 'page' : undefined}>{t.nav.home}</a></li>
          <li><a href="/how" aria-current={here === '/how' ? 'page' : undefined}>{t.footer.how}</a></li>
          <li><a href="/privacy" aria-current={here === '/privacy' ? 'page' : undefined}>{t.footer.privacy}</a></li>
          <li><a href="/terms" aria-current={here === '/terms' ? 'page' : undefined}>{t.footer.terms}</a></li>
          <li><LanguageSwitcher locale={locale} next={next} /></li>
          <li>
            <a href="https://dash.echovalue.dev" class="navbar-cta" target="_blank" rel="noopener noreferrer">{t.nav.dashboard}</a>
          </li>
        </ul>
      </div>
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <ul class="footer-links">
            <li><a href="https://www.echovalue.dev/" target="_blank" rel="noopener noreferrer">Home</a></li>
            <li><a href="https://www.echovalue.dev/db-api/" target="_blank" rel="noopener noreferrer">DB API</a></li>
            <li><a href="https://www.echovalue.dev/webhook-api/" target="_blank" rel="noopener noreferrer">Webhook API</a></li>
            <li><a href="https://docs.echovalue.dev" target="_blank" rel="noopener noreferrer">Documentation</a></li>
            <li><a href="https://dash.echovalue.dev" target="_blank" rel="noopener noreferrer">Dashboard</a></li>
            <li><a href="/privacy">{t.footer.privacy}</a></li>
            {
              sourceUrl && (
                <li>
                  <a href={sourceUrl} title={t.footer.sourceLabel} target="_blank" rel="noopener noreferrer">{t.footer.source}</a>
                </li>
              )
            }
            <li><a href="/terms">{t.footer.terms}</a></li>
          </ul>
        </div>
        <div class="footer-bottom">
          <p>
            Built by <a href="https://www.njoylab.com" target="_blank" rel="noopener noreferrer">nJoyLab.com</a> ·
            IT12822520966 · <span class="text-mono">v2.0</span>
          </p>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.navbar-toggle');
      const nav = document.querySelector('.navbar-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          toggle.classList.toggle('active');
          nav.classList.toggle('active');
        });
        for (const link of nav.querySelectorAll('a')) {
          link.addEventListener('click', () => {
            toggle.classList.remove('active');
            nav.classList.remove('active');
          });
        }
      }
    </script>
    <script>
      const themeButton = document.querySelector('.theme-toggle');
      if (themeButton) {
        const stored = localStorage.getItem('theme');
        const apply = (theme: string) => {
          if (theme === 'light') document.documentElement.setAttribute('data-theme', 'light');
          else document.documentElement.removeAttribute('data-theme');
        };
        apply(stored || 'dark');
        themeButton.addEventListener('click', () => {
          const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          apply(next);
          localStorage.setItem('theme', next);
        });
      }
    </script>
  </body>
</html>
