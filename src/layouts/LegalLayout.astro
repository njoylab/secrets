---
/**
 * Shared shell for the document pages (privacy, terms, how it works): title,
 * revision date, summary and the sections. The prose lives in `src/lib/legal.ts`
 * and `src/lib/how.ts`; nothing is written here.
 */
import Layout from './Layout.astro';
import { getDictionary } from '../lib/i18n.ts';
import { resolveLegalText, type LegalDocument } from '../lib/legal.ts';

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
const locale = Astro.locals.locale;
const t = getDictionary(locale);
// Read in the reader's language, from the ISO date in UTC so the day cannot shift.
const updated = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(
  new Date(`${document.updated}T00:00:00Z`),
);
// Links are resolved into parts, so the prose below is rendered as text.
const parts = (text: string) => resolveLegalText(text, locale);
---

<Layout title={document.title} description={document.summary}>
  <article class="legal">
    <header class="legal-head">
      <h1 class="page-title">{document.title}</h1>
      <p class="legal-updated">
        <span class="meta-label">{t.legal.updated}</span>
        <time datetime={document.updated}>{updated}</time>
      </p>
      <p class="legal-summary">{document.summary}</p>
    </header>

    {document.sections.map((section) => (
      <section class="legal-section">
        <h2>{section.heading}</h2>
        {section.blocks.map((block) =>
          block.kind === 'list' ? (
            <ul>
              {block.items.map((item) => <li>{parts(item).map((part) => (typeof part === 'string' ? <Fragment>{part}</Fragment> : <a href={part.href}>{part.label}</a>))}</li>)}
            </ul>
          ) : (
            <p>{parts(block.text).map((part) => (typeof part === 'string' ? <Fragment>{part}</Fragment> : <a href={part.href}>{part.label}</a>))}</p>
          ),
        )}
      </section>
    ))}
  </article>
</Layout>
