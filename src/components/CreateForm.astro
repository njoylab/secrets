---
import {
  DEFAULT_EXPIRY_DAYS,
  MAX_EXPIRY_DAYS,
  MAX_PASSWORD_LENGTH,
  MAX_SECRET_BYTES,
  MIN_EXPIRY_DAYS,
} from '../lib/secrets.ts';
import { getDictionary } from '../lib/i18n.ts';
import PasswordField from './PasswordField.astro';

const t = getDictionary(Astro.locals.locale);
---

<form
  id="create-form"
  class="form"
  novalidate
  data-error-secret-required={t.errors.secretRequired}
  data-error-secret-too-long={t.errors.secretTooLong}
  data-error-invalid-expiry={t.errors.invalidExpiry}
  data-error-password-too-long={t.errors.passwordTooLong}
  data-error-server={t.errors.serverError}
  data-secret-max={MAX_SECRET_BYTES}
  data-password-max={MAX_PASSWORD_LENGTH}
>
  <div class="field">
    <label for="secret">{t.create.secretLabel}</label>
    <textarea
      id="secret"
      name="secret"
      rows="7"
      required
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      placeholder={t.create.secretPlaceholder}
      aria-describedby="secret-hint"
    ></textarea>
    <p class="note" id="secret-hint">{t.create.secretHint}</p>
  </div>

  <div class="field">
    <label for="expiry">{t.create.expiryLabel}</label>
    <div class="control">
      <input
        id="expiry"
        name="expiresInDays"
        type="number"
        inputmode="numeric"
        min={MIN_EXPIRY_DAYS}
        max={MAX_EXPIRY_DAYS}
        step="1"
        value={DEFAULT_EXPIRY_DAYS}
        aria-describedby="expiry-unit"
      />
      <span class="suffix" id="expiry-unit">{t.create.expirySuffix}</span>
    </div>
  </div>

  <PasswordField
    id="create-password"
    label={t.create.passwordLabel}
    showLabel={t.create.passwordShow}
    hideLabel={t.create.passwordHide}
    describedBy="note-password"
    autocomplete="new-password"
  />

  <ul class="notes">
    <li id="note-password">{t.create.notePassword}</li>
    <li>{t.create.noteSingleRead}</li>
  </ul>

  <p class="status" id="create-status" role="status" aria-live="polite"></p>

  <button
    type="submit"
    class="btn btn-primary btn-block"
    id="create-submit"
    data-label-idle={t.create.submit}
    data-label-busy={t.create.submitting}
  >
    {t.create.submit}
  </button>
</form>
