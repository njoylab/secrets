---
import {
  DEFAULT_EXPIRY_PRESET,
  EXPIRY_PRESETS,
  MAX_PASSWORD_LENGTH,
  MAX_SECRET_BYTES,
} from '../lib/secrets.ts';
import { getDictionary } from '../lib/i18n.ts';
import Icon from './Icon.astro';
import PasswordField from './PasswordField.astro';

const t = getDictionary(Astro.locals.locale);
---

<form
  id="create-form"
  class="form"
  novalidate
  data-error-payload-required={t.errors.payloadRequired}
  data-error-payload-too-long={t.errors.payloadTooLong}
  data-error-invalid-expiry={t.errors.invalidExpiry}
  data-error-password-too-long={t.errors.passwordTooLong}
  data-error-server={t.errors.serverError}
  data-secret-max={MAX_SECRET_BYTES}
  data-password-max={MAX_PASSWORD_LENGTH}
  data-expiry-presets={EXPIRY_PRESETS.join(',')}
  data-expiry-labels={JSON.stringify(t.create.expiryOptions)}
>
  <div class="field">
    <label for="secret">{t.create.secretLabel}</label>
    <textarea
      id="secret"
      name="secret"
      rows="7"
      required
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      translate="no"
      placeholder={t.create.secretPlaceholder}
      aria-describedby="secret-hint"
    ></textarea>
    <p class="note" id="secret-hint">{t.create.secretHint}</p>
  </div>

  <div class="field">
    <label for="expiry"><Icon name="clock" />{t.create.expiryLabel}</label>
    <select id="expiry" name="expiresIn">
      {
        EXPIRY_PRESETS.map((preset) => (
          <option value={preset} selected={preset === DEFAULT_EXPIRY_PRESET}>
            {t.create.expiryOptions[preset]}
          </option>
        ))
      }
    </select>
  </div>

  <PasswordField
    id="create-password"
    label={t.create.passwordLabel}
    showLabel={t.create.passwordShow}
    hideLabel={t.create.passwordHide}
    describedBy="note-password"
    autocomplete="new-password"
  />

  <ul class="notes">
    <li id="note-password">{t.create.notePassword}</li>
    <li>{t.create.noteSingleRead}</li>
  </ul>

  <p class="status" id="create-status" role="status" aria-live="polite"></p>

  <button
    type="submit"
    class="btn btn-primary btn-block"
    id="create-submit"
    data-label-idle={t.create.submit}
    data-label-busy={t.create.submitting}
  >
    <Icon name="key" />
    <span class="btn-label">{t.create.submit}</span>
  </button>
</form>
