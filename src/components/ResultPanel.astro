---
import { getDictionary } from '../lib/i18n.ts';
import Icon from './Icon.astro';
import Panel from './Panel.astro';

const locale = Astro.locals.locale;
const t = getDictionary(locale);
---

<Panel id="result-panel" heading={t.result.title} headingId="result-title" hidden>
  <div class="field">
    <label for="result-link"><Icon name="key" />{t.result.linkLabel}</label>
    <div class="copy-row">
      <input
        id="result-link"
        class="input-mono"
        type="text"
        readonly
        spellcheck="false"
        autocomplete="off"
        translate="no"
        aria-describedby="result-note"
      />
      <button
        type="button"
        class="btn btn-ghost btn-copy"
        id="result-copy"
        data-label-idle={t.result.copy}
        data-label-done={t.result.copied}
        data-label-failed={t.result.copyFailed}
      >
        <Icon name="copy" class="icon icon-copy" />
        <Icon name="check" class="icon icon-done" />
        <span class="btn-label">{t.result.copy}</span>
      </button>
    </div>
  </div>

  <!--
    The control link can destroy the secret, so it never looks like the
    one-time link: danger label, shield mark and a line saying what it does.
  -->
  <div class="field field-kill" id="result-control-field">
    <label for="result-control-link"><Icon name="shield" />{t.result.controlLabel}</label>
    <div class="copy-row">
      <input
        id="result-control-link"
        class="input-mono"
        type="text"
        readonly
        spellcheck="false"
        autocomplete="off"
        translate="no"
        aria-describedby="result-control-hint"
      />
      <button
        type="button"
        class="btn btn-ghost btn-copy"
        id="result-control-copy"
        data-label-idle={t.result.copy}
        data-label-done={t.result.copied}
        data-label-failed={t.result.copyFailed}
      >
        <Icon name="copy" class="icon icon-copy" />
        <Icon name="check" class="icon icon-done" />
        <span class="btn-label">{t.result.copy}</span>
      </button>
    </div>
    <p class="note" id="result-control-hint">{t.result.controlHint}</p>
  </div>

  <!-- Only shown when a password was set: it leaves the form with the secret.
       Masked like the input it came from; the toggle reveals it on request.
       The reveal is wired by the generic script in PasswordField.astro, which
       CreateForm renders on this same page. -->
  <div class="field" id="result-password-field" hidden>
    <div class="field-head">
      <label for="result-password"><Icon name="lock" />{t.result.passwordLabel}</label>
      <button
        type="button"
        class="btn btn-ghost"
        id="result-password-toggle"
        data-password-toggle="result-password"
        aria-controls="result-password"
      >
        {t.result.passwordShow}
      </button>
    </div>
    <div class="copy-row">
      <input
        id="result-password"
        class="input-mono"
        type="password"
        readonly
        spellcheck="false"
        autocomplete="off"
        translate="no"
        aria-describedby="note-password-echo"
        data-password-label-show={t.result.passwordShow}
        data-password-label-hide={t.result.passwordHide}
      />
      <button
        type="button"
        class="btn btn-ghost btn-copy"
        id="result-password-copy"
        data-label-idle={t.result.copy}
        data-label-done={t.result.copied}
        data-label-failed={t.result.copyFailed}
      >
        <Icon name="copy" class="icon icon-copy" />
        <Icon name="check" class="icon icon-done" />
        <span class="btn-label">{t.result.copy}</span>
      </button>
    </div>
    <p class="note" id="note-password-echo">{t.create.notePassword}</p>
  </div>

  <p class="meta" id="result-expiry">
    <span class="meta-label">{t.result.expires}</span>
    <span id="result-expiry-preset"></span>
    <span id="result-expiry-value" class="meta-value" data-locale={locale}></span>
  </p>

  <!--
    The QR encodes the share link with the key in its fragment, so it is only
    drawn once the link exists. It is a canvas rather than an image: it is
    generated in the browser from a string that never leaves the page, and an
    image element would need a data URL or an object URL to hold it.
  -->
  <div class="field" id="result-qr-field" hidden>
    <p class="field-head">
      <span class="field-label" id="result-qr-label">{t.result.qrLabel}</span>
    </p>
    <canvas
      id="result-qr"
      class="qr"
      role="img"
      aria-labelledby="result-qr-label"
      aria-describedby="result-qr-hint"
      width="232"
      height="232"
      hidden
    >
    </canvas>
    <p class="note" id="result-qr-hint">{t.result.qrHint}</p>
  </div>

  <p class="note" id="result-note">{t.result.noteKeyInFragment}</p>

  <p class="status" id="result-status" role="status" aria-live="polite"></p>

  <button type="button" class="btn btn-block" id="result-another">{t.result.another}</button>
</Panel>