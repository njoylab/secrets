---
import { getDictionary } from '../lib/i18n.ts';
import Panel from './Panel.astro';

const locale = Astro.locals.locale;
const t = getDictionary(locale);
---

<Panel id="result-panel" heading={t.result.title} headingId="result-title" hidden>
  <div class="field">
    <label for="result-link">{t.result.linkLabel}</label>
    <div class="copy-row">
      <input
        id="result-link"
        class="input-mono"
        type="text"
        readonly
        spellcheck="false"
        autocomplete="off"
        aria-describedby="result-note"
      />
      <button
        type="button"
        class="btn btn-ghost"
        id="result-copy"
        data-label-idle={t.result.copy}
        data-label-done={t.result.copied}
        data-label-failed={t.result.copyFailed}
      >
        {t.result.copy}
      </button>
    </div>
  </div>

  <div class="field">
    <label for="result-control-link">{t.result.controlLabel}</label>
    <div class="copy-row">
      <input
        id="result-control-link"
        class="input-mono"
        type="text"
        readonly
        spellcheck="false"
        autocomplete="off"
      />
      <button
        type="button"
        class="btn btn-ghost"
        id="result-control-copy"
        data-label-idle={t.result.copy}
        data-label-done={t.result.copied}
        data-label-failed={t.result.copyFailed}
      >
        {t.result.copy}
      </button>
    </div>
  </div>

  <!-- Only shown when a password was set: it leaves the form with the secret. -->
  <div class="field" id="result-password-field" hidden>
    <label for="result-password">{t.result.passwordLabel}</label>
    <div class="copy-row">
      <input
        id="result-password"
        class="input-mono"
        type="text"
        readonly
        spellcheck="false"
        autocomplete="off"
      />
      <button
        type="button"
        class="btn btn-ghost"
        id="result-password-copy"
        data-label-idle={t.result.copy}
        data-label-done={t.result.copied}
        data-label-failed={t.result.copyFailed}
      >
        {t.result.copy}
      </button>
    </div>
  </div>

  <p class="meta" id="result-expiry">
    <span class="meta-label">{t.result.expires}</span>
    <span id="result-expiry-preset"></span>
    <span id="result-expiry-value" data-locale={locale}></span>
  </p>

  <p class="note" id="result-note">{t.result.noteKeyInFragment}</p>

  <p class="status" id="result-status" role="status" aria-live="polite"></p>

  <button type="button" class="btn btn-block" id="result-another">{t.result.another}</button>
</Panel>
