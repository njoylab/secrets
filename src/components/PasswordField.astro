---
import Icon from './Icon.astro';

interface Props {
  id: string;
  label: string;
  showLabel: string;
  hideLabel: string;
  required?: boolean;
  describedBy?: string;
  autocomplete?: string;
}

const {
  id,
  label,
  showLabel,
  hideLabel,
  required = false,
  describedBy,
  autocomplete = 'off',
} = Astro.props;
---

<div class="field">
  <div class="field-head">
    <label for={id}><Icon name="lock" />{label}</label>
    <button type="button" class="btn btn-ghost" data-password-toggle={id} aria-controls={id}>
      {showLabel}
    </button>
  </div>
  {/* Omit name so native form submission can never serialize a password. */}
  <input
    id={id}
    type="password"
    class="input-mono"
    autocomplete={autocomplete}
    spellcheck="false"
    required={required ? true : undefined}
    aria-required={required ? 'true' : undefined}
    aria-describedby={describedBy}
    data-password-label-show={showLabel}
    data-password-label-hide={hideLabel}
  />
</div>

<script>
  // Show/hide toggle: generic over every password field rendered on the page.
  const fields = document.querySelectorAll<HTMLInputElement>('input[data-password-label-show]');

  for (const field of fields) {
    const toggle = document.querySelector<HTMLButtonElement>(
      `button[data-password-toggle="${CSS.escape(field.id)}"]`,
    );
    if (!toggle) continue;

    const showLabel = field.dataset.passwordLabelShow ?? '';
    const hideLabel = field.dataset.passwordLabelHide ?? '';

    toggle.addEventListener('click', () => {
      const hidden = field.type === 'password';
      field.type = hidden ? 'text' : 'password';
      toggle.textContent = hidden ? hideLabel : showLabel;
    });
  }
</script>
