---
/**
 * Inline stroke icons on a 16x16 grid, drawn in currentColor. Kept as a single
 * component so the weight, the grid and the "no external asset" rule hold for
 * every mark in the interface.
 */
export type IconName = 'alert' | 'check' | 'clock' | 'copy' | 'key' | 'lock' | 'shield';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

// Closed and open sets are limited to what the three flows actually need:
// create (clock, lock), result (key, shield, copy) and reveal (lock, copy).
const paths: Record<IconName, string> = {
  alert: '<path d="M8 1.9 14.6 13.6H1.4Z"/><path d="M8 6.3v3.1M8 11.3v.5"/>',
  check: '<path d="m3.2 8.4 3.1 3.1 6.5-6.9"/>',
  clock: '<circle cx="8" cy="8" r="6.3"/><path d="M8 4.4V8l2.5 1.6"/>',
  copy: '<rect x="6" y="6" width="8.4" height="9" rx="1.4"/><path d="M3.6 10.2V4.6A1.4 1.4 0 0 1 5 3.2h5.6"/>',
  key: '<circle cx="5.4" cy="10.6" r="2.6"/><path d="m7.4 8.6 5.6-5.6"/><path d="m10.8 5.2 1.6 1.6"/><path d="m12.2 3.8 1.6 1.6"/>',
  lock: '<rect x="3.4" y="7.1" width="9.2" height="6.5" rx="1.4"/><path d="M5.6 7.1V5a2.4 2.4 0 0 1 4.8 0v2.1"/>',
  shield: '<path d="M8 1.8 13.2 3.7v4.6c0 3.1-2.2 5.3-5.2 6.6-3-1.3-5.2-3.5-5.2-6.6V3.7Z"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><Fragment set:html={paths[name]} /></svg>