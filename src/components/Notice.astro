---
interface Props {
  heading: string;
  hint?: string;
  id?: string;
  headingId?: string;
  /** Lets a script replace the hint, which is the only place a page can explain itself. */
  hintId?: string;
  /** Marks the hint as a live region: used where the panel replaces the form. */
  live?: boolean;
  class?: string;
  hidden?: boolean;
}

const {
  heading,
  hint,
  id,
  headingId,
  hintId,
  live = false,
  class: className,
  hidden = false,
} = Astro.props;
---

<section
  id={id}
  class:list={['project-card', 'tool-card', className]}
  tabindex="-1"
  aria-labelledby={headingId}
  hidden={hidden ? true : undefined}
>
  <div class="project-card-header">
    <h2 class="panel-title" id={headingId}>{heading}</h2>
  </div>
  {hint && (
    <div class="project-card-content">
      <p class="note" id={hintId} role={live ? 'status' : undefined} aria-live={live ? 'polite' : undefined}>{hint}</p>
    </div>
  )}
</section>
