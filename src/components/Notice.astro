---
interface Props {
  heading: string;
  hint?: string;
  id?: string;
  headingId?: string;
  /** Lets a script replace the hint, which is the only place a page can explain itself. */
  hintId?: string;
  class?: string;
  hidden?: boolean;
}

const { heading, hint, id, headingId, hintId, class: className, hidden = false } = Astro.props;
---

<section
  id={id}
  class:list={['panel', className]}
  tabindex="-1"
  aria-labelledby={headingId}
  hidden={hidden ? true : undefined}
>
  <h2 class="panel-title" id={headingId}>{heading}</h2>
  {hint && <p class="note" id={hintId}>{hint}</p>}
</section>
